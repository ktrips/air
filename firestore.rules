rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if resource == null || resource.data.public == true || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      // リストクエリ用：公開トリップまたは自分のトリップを取得可能
      allow list: if resource == null || resource.data.public == true || (request.auth != null && resource.data.userId == request.auth.uid);
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
