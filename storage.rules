rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /trips/{tripId}/photos/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /trips/{tripId}/gpx/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /trips/{tripId}/travelogue/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /trips/{tripId}/animes/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /trips/{tripId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && fileName.matches('character\\..*');
    }
  }
}
