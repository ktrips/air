{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "service-account.json",
      "backup/**",
      "docs/**",
      "scripts/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "deploy.sh",
      "setup-cors.sh",
      "cors.json",
      "firestore.rules",
      "storage.rules",
      "config.example.js",
      "config.template.js",
      "firebase-config.example.js"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
